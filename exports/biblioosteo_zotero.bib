  abstract = {Étude de cohorte prospective intra-patient de très haut niveau de preuve (*The Spine Journal*, nov. 2026, IF 4,9) portant sur **68 patients** (âge médian 64,0 ans) suspects de spondylodiscite à pyogènes sans collection abcédée liquidienne, chez qui une **biopsie percutanée simultanée du disque intervertébral ET du corps vertébral adjacent** a été réalisée : **le prélèvement du disque intervertébral offre un taux de positivité bactériologique significativement supérieur à celui du corps vertébral (51,5 % [35/68] vs 32,4 % [22/68], $p = 0,002$ au test apparié de McNemar)** ; en analyse multivariée GEE, le site discal, l'élévation de la VS, de la procalcitonine (PCT), de l'IL-6 et l'inflammation aiguë en histopathologie sont indépendamment associés à la positivité des cultures ($p < 0,05$).}
}

@article{toader2026_43043429,
