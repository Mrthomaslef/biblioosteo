  author = {Tse S and Chinweze RO and Velasco-Castro J and Andring N and Jbeily E and Robinson C and Saade A and Simister S and Campbell ST and Fitzpatrick E and Lee MA and Saiz AM and Soles GL},
  journal = {Injury},
