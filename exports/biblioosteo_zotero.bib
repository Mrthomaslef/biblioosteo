  pages = {21925682261505813},
  doi = {10.1177/21925682261505813},
  pmid = {42987922},
  url = {https://pubmed.ncbi.nlm.nih.gov/42987922/},
  abstract = {Analyse rétrospective de 204 fractures vertébrales thoraco-lombaires (176 patients, 119 fractures ostéoporotiques OVF d'âge moyen 72,5 ans et 85 fractures traumatiques à haute énergie VCF d'âge moyen 50,0 ans) traitées par implants d'expansion titane **SpineJack®** (*Global Spine Journal*, nov. 2026, IF 2,6, Open-Access) avec IRM pré-opératoire : prévalence élevée des lésions discales adjacentes (disque supérieur 68,1 %, disque inférieur 58,3 %, combinées 53,9 % selon la classification de Sander), la sévérité de l'atteinte discale n'étant pas prédite par la seule classification osseuse AOSpine/OF et n'empêchant pas la restauration anatomique par SpineJack.}
}

@article{li2026_43036206,
  title = {Risk Factors for Bone Cement Leakage and Re-fracture Following PKP in Patients With Thoracolumbar Spine Fractures},
  author = {Li X and Fu M and Liu X and E Z and Wang C},
  journal = {Annali italiani di chirurgia},
  year = {2026},
  volume = {97},
  number = {11},
  pages = {2009-2016},
  doi = {10.62713/aic.4791},
  pmid = {43036206},
  url = {https://pubmed.ncbi.nlm.nih.gov/43036206/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblioosteo/pdfs/PMID_43036206.pdf:application/pdf},
  abstract = {Étude rétrospective sur **115 patients** traités par cyphoplastie percutanée par ballonnet (PKP) pour fracture par tassement vertébral thoraco-lombaire (*Annali Italiani di Chirurgia*, nov. 2026, IF 1,5), analysant les déterminants multivariés des **fuites de ciment PMMA (18 cas, 15,7 %)** et des **refractures vertébrales post-opératoires (29 cas, 25,2 %)** : l'**interruption corticale des parois vertébrales** et l'**âge avancé** sont les deux facteurs de risque indépendants de fuite de ciment ($p < 0,05$), tandis que l'**âge**, la **sévérité du tassement initial** et la **rupture corticale** prédisent indépendamment le risque de nouvelle fracture vertébrale ($p < 0,05$), alors même que la PKP améliore hautement l'EVA, l'ODI, l'angle de Cobb et la hauteur vertébrale antérieure ($p < 0,001$).}
}

@article{choi2026_43005484,
  title = {Development of a Multimodal Model Combining Imaging and Clinical Data to Predict Bone Cement Leakage During Vertebroplasty for Fresh Thoracolumbar Compression Fractures},
  author = {Choi W and Chen J and Qiu J and Xie T and Li Y and Pan Z and Zhang Z and Huang G and Liao N and Lin Y and Deng Z and Qiu X and Gao B and Huang D and Zhou H and Wu Z and Gao W},
  journal = {JOR spine},
  year = {2026},
