  number = {4},
  pages = {e70227},
  doi = {10.1002/jsp2.70227},
  pmid = {43005484},
  url = {https://pubmed.ncbi.nlm.nih.gov/43005484/},
  abstract = {Étude multicentrique avec validation externe et prospective portant sur **486 vertèbres fraîches traitées par vertébroplastie percutanée (PVP) chez 378 patients** (*JOR Spine*, nov./déc. 2026, IF 3,4, Open-Access) : l'analyse d'interprétabilité SHAP et la régression multivariée démontrent que la **destruction corticale**, l'**atteinte du mur postérieur**, le **volume de ciment injecté** et l'**IMC** sont les prédicteurs indépendants majeurs de fuite de ciment, le modèle multimodal combinant clinique, séméiologie TDM et radiomique atteignant une **AUC de 0,902–0,939 en test interne, 0,722–0,929 en validation externe et 0,834–0,925 en validation prospective**.}
}

@article{tenhoeve2026_43050914,
  title = {Percutaneous screw distraction versus open fusion surgery for anatomic restoration after burst fracture},
  author = {Tenhoeve SA and Findlay MC and Brown JD and Orton S and Olcott JR and Ray WZ and Stillerman CB and Dailey AT and Mahan MA},
  journal = {Journal of clinical neuroscience : official journal of the Neurosurgical Society of Australasia},
  year = {2026},
  volume = {156},
  pages = {112390},
  doi = {10.1016/j.jocn.2026.112390},
  pmid = {43050914},
  url = {https://pubmed.ncbi.nlm.nih.gov/43050914/},
  abstract = {Étude de cohorte rétrospective en centre de traumatologie de niveau I comparant **24 patients traités par ostéosynthèse transpédiculaire percutanée à angle fixe avec distraction** à **39 patients opérés par arthrodèse postérieure ouverte** pour une fracture corporéale comminutive thoraco-lombaire (**burst fracture AO Spine A2, A3 et A4**) sans laminectomie directe entre 2018 et 2024 (*Journal of Clinical Neuroscience*, nov. 2026, IF 1,9) : à répartition fracturaire identique ($p = 0,25$), l'approche **percutanée réduit significativement les pertes sanguines per-opératoires ($p < 0,001$)**, procure un **gain supérieur de surface canalaire rachidienne par décompression indirecte (ligamentotaxis) entre le scanner pré- et post-opératoire ($p = 0,01$)** et maintient un **meilleur indice de hauteur corporéale vertébrale au dernier suivi ($p = 0,02$)**.}
}

@article{doria2026_43064621,
  title = {Clinical and radiographic outcomes of SpineJack mechanical kyphoplasty versus conservative management in traumatic thoraco-lumbar compression fractures},
  author = {D'Oria S and Salamone GG and Trevisi G and Tomatis A and Labriola M and Murrone D and Giraldi D and Fanelli V and Fontanarosa A and Del Buono A and Garofalo R and Maffulli N},
  journal = {The surgeon : journal of the Royal Colleges of Surgeons of Edinburgh and Ireland},
  year = {2026},
  doi = {10.1016/j.surge.2026.11.003},
  pmid = {43064621},
  url = {https://pubmed.ncbi.nlm.nih.gov/43064621/},
  abstract = {Étude de cohorte prospective comparative portant sur **246 patients consécutifs neurologiquement intacts** atteints d'une fracture-tassement traumatique thoraco-lombaire (**Magerl / AO Spine type A**) entre janvier 2018 et décembre 2023 (**122 patients traités par kyphoplastie mécanique percutanée SpineJack** [Groupe B, 100 évalués à 12 mois] vs **124 traités orthopédiquement par repos au lit et corset 3 points** [Groupe A, 104 évalués à 12 mois]) (*The Surgeon*, nov. 2026, IF 2,3) : la **kyphoplastie mécanique SpineJack** démontre une **supériorité statistiquement significative à 1, 6 et 12 mois sur le soulagement douloureux (EVA/VAS)**, la **récupération fonctionnelle (indice d'Oswestry ODI)**, la **restauration du taux de perte de hauteur vertébrale (HLR)** et la **correction de l'angle de cyphose régionale (RKA)**.}
}

@article{wang2026_43034775,
  title = {Percutaneous Vertebroplasty versus Non-Surgical Controls for Osteoporotic Vertebral Compression Fractures: A Systematic Review and Meta-Analysis of Pain, Fracture, and Safety Outcomes},
  author = {Wang T and Zhou J and Wang Y},
  journal = {Therapeutics and clinical risk management},
  year = {2026},
  volume = {22},
  pages = {646677},
  doi = {10.2147/tcrm.s646677},
  pmid = {43034775},
  url = {https://pubmed.ncbi.nlm.nih.gov/43034775/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblioosteo/pdfs/PMID_43034775.pdf:application/pdf},
  abstract = {Revue systématique et méta-analyse PRISMA 2020 regroupant **20 essais contrôlés randomisés (ECR) et 2 238 patients** comparant la **vertébroplastie percutanée** aux traitements non chirurgicaux dans les fractures vertébrales ostéoporotiques par compression jusqu'en avril 2026 (*Therapeutics and Clinical Risk Management*, nov. 2026, IF 2,3, Open-Access PMC13769260) : la vertébroplastie procure une **réduction douloureuse statistiquement supérieure au traitement conservateur dès 1 semaine ($\textSMD = -1,22$, IC 95 % $-1,93$ à $-0,50$)** et maintenue à **1 mois ($\textSMD = -1,17$)**, **3 mois ($\textSMD = -0,84$)**, **6 mois ($\textSMD = -0,86$)** et **12 mois ($\textSMD = -0,69$, IC 95 % $-1,06$ à $-0,32$)**, **sans aucune augmentation du risque de nouvelle fracture vertébrale ($\textRR = 1,04$, IC 95 % 0,81–1,34)** et avec une **tendance à la réduction des événements indésirables graves ($\textRR = 0,58$, IC 95 % 0,33–1,00)** liés au décubitus.}
}

@article{lianou2026_43020664,
