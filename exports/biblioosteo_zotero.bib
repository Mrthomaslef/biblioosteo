  url = {https://pubmed.ncbi.nlm.nih.gov/43071814/},
  abstract = {Observation clinique (*JBJS Case Connector*, oct. 2026, IF 0,8, Open-Access PMC13787528) rapportant une **fracture de contrainte atraumatique du fémur distal** survenue **6 semaines après l'ablation par radiofréquence (RF) guidée par scanner** d'un **ostéome ostéoïde cortical fémoral distal** chez une adolescente de 16 ans, réalisée via un **trocart d'accès osseux de gros calibre (10G)** : la mise en **décharge stricte pendant 6 semaines**, l'arrêt des AINS et la supplémentation en vitamine D ont permis une **consolidation radiographique complète et une guérison clinique totale à 12 mois** sans ostéosynthèse chirurgicale.}
}

@article{li2026_42995340,
  title = {Determinants of fluoroscopy frequency and effect of standardized workflow optimization in robot-assisted pelvic channel screw placement: a single-center retrospective cohort study},
  author = {Li J and Zhang W and Gong T and Li X and Yin K and Zhang X and Tai H},
  journal = {Journal of robotic surgery},
  year = {2026},
  volume = {20},
  number = {1},
  pages = {1180},
  doi = {10.1007/s11701-026-04112-y},
  pmid = {42995340},
  url = {https://pubmed.ncbi.nlm.nih.gov/42995340/},
  abstract = {Vaste cohorte rétrospective monocentrique (*Journal of Robotic Surgery*, nov. 2026, IF 2,2, 601 patients : 312 avant et 289 après optimisation) identifiant les 4 facteurs indépendants augmentant le recours à la scopie lors du vissage pelvien percutané (surface osseuse oblique au point d'entrée cortical IRR = 1,52, courbe d'apprentissage des 10 premiers cas IRR = 1,48, vissage du couloir S2 IRR = 1,26 et obésité IMC ≥ 30 IRR = 1,19) et démontrant qu'un protocole standardisé réduit de 27 % le nombre de clichés et le temps de scopie (16,2 s vs 21,8 s, p < 0,001) avec 98,7 % de précision intra-osseuse.}
}

@article{tse2026_43019680,
