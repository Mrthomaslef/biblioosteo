  journal = {European journal of clinical microbiology & infectious diseases : official publication of the European Society of Clinical Microbiology},
  year = {2025},
  volume = {44},
  number = {12},
  pages = {3067-3078},
  doi = {10.1007/s10096-025-05292-5},
  pmid = {41023355},
  url = {https://pubmed.ncbi.nlm.nih.gov/41023355/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblioosteo/pdfs/PMID_41023355.pdf:application/pdf},
  abstract = {Étude rétrospective longitudinale sur **14 ans (98 patients consécutifs)** analysant l'épidémiologie, le rendement diagnostique microbiologique et d'imagerie ainsi que les facteurs pronostiques des **spondylodiscites infectieuses** (*European Journal of Clinical Microbiology & Infectious Diseases*, déc. 2025, IF 3,7, Open-Access PMC12753542) : les **spondylodiscites à pyogènes représentent 54 % des cas (dont 64 % à *Staphylococcus aureus*, 34 cas) et la tuberculose (mal de Pott) 10 %** ; la localisation est **lombaire dans 63 %, thoracique dans 25 % et cervicale dans 12 %** ; les **hémocultures sont positives dans 47 % des formes à pyogènes (25 % de la cohorte totale)**, la **TEP-TDM au 18F-FDG offre une performance diagnostique supérieure (83 %)** à la scintigraphie aux leucocytes marqués (54 %), et l'**atteinte cervicale ($\textOR = 4,76$) ou thoracique ($\textOR = 3,89$)** prédit indépendamment une évolution défavorable (abcès épiduraux/paravertébraux dans 45 %, atteinte radiculaire dans 51 %, endocardite associée dans 14 %).}
}

