  pmid = {42200532},
  url = {https://pubmed.ncbi.nlm.nih.gov/42200532/},
  abstract = {Note technique de référence (*Journal of Orthopaedic Trauma*, nov. 2026, IF 2,3) décrivant l'utilisation de reconstructions TDM 3D volumétriques pré-opératoires orientées dans les plans exacts d'Inlet (superposition de la corticale antérieure du corps de S1) et d'Outlet (tunnel foraminal S1 vu de face) pour guider le vissage ilio-sacré percutané : permet d'identifier avec certitude quelle ligne dense corticale correspond à la limite antérieure réelle de S1 en se calant sur la morphologie de l'anneau pelvien antérieur et l'obliquité des trous obturateurs, sécurisant le geste face aux variations anatomiques fréquentes (sacrum dysmorphique, récessus corticaux alaires profonds, ostéophytes marginaux ou pente sacrée extrême).}
}

@article{scherer2026_42987922,
