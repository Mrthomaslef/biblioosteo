  number = {12},
  pages = {113886},
  doi = {10.1016/j.injury.2026.113886},
  pmid = {43019680},
  url = {https://pubmed.ncbi.nlm.nih.gov/43019680/},
  abstract = {Étude comparative sur 245 patients (*Injury*, nov. 2026, IF 2,2) opérés d'un vissage percutané de l'anneau pelvien postérieur entre 2014 et 2023 sous fluoroscopie 3D per-opératoire (3DF, n = 89) versus fluoroscopie 2D conventionnelle + scanner post-opératoire (2DF, n = 156) : réduction par 3 de la dose d'irradiation cumulée totale (179,2 mGy vs 526,1 mGy, p < 0,001), réduction par 4 de la dose per-opératoire seule (médiane 79,1 mGy vs 318,0 mGy, p < 0,001) et baisse significative du taux de réintervention chirurgicale à moyen terme (9,5 % vs 31,2 %, p = 0,012).}
}

@article{zuelzer2026_42200532,
