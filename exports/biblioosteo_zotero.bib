  author = {Lianou I and Kaspiris A and Repantis T and Sakellariou E and Papaioannou I and Baikousis A and Korovessis P and Vasiliadis ES and Pneumaticos SG},
  journal = {International journal of spine surgery},
  year = {2026},
  pages = {8990},
  doi = {10.14444/8990},
  pmid = {43020664},
  url = {https://pubmed.ncbi.nlm.nih.gov/43020664/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblioosteo/pdfs/PMID_43020664.pdf:application/pdf},
  abstract = {Étude rétrospective monocentrique en centre tertiaire comparant les résultats de la **cyphoplastie par ballonnet précoce (réalisée $\le 7\text jours$ après le diagnostic radiologique)** d'une **fracture par compression vertébrale ostéoporotique aiguë** chez **98 patients âgés** répartis en deux cohortes d'âge : **$< 80\text ans$ (Groupe A, $n = 53$)** versus **$\ge 80\text ans$ (Groupe B, $n = 45$)** (*International Journal of Spine Surgery*, nov. 2026, IF 1,7) : les **deux groupes présentent une amélioration hautement significative et équivalente du score douloureux EVA et de la restauration de hauteur corporéale (index de Beck, $p < 0,0001$)**, avec des **taux de fuite de ciment, de re-fracture et de fracture du niveau adjacent strictement comparables entre octogénaires ($\ge 80\text ans$) et patients $< 80\text ans$**.}
}

@article{burke2026_43033237,
  title = {Image-guided ablation treatment of Desmoid tumors: an approach for management and integration into the national comprehensive cancer network ® guidelines},
  author = {Burke CJ and Block JJ and Ingham M and Samim M},
  journal = {Skeletal radiology},
  year = {2026},
  doi = {10.1007/s00256-026-05436-4},
  pmid = {43033237},
  url = {https://pubmed.ncbi.nlm.nih.gov/43033237/},
  abstract = {Mise au point de référence (*Skeletal Radiology*, nov. 2026, IF 1,9) consacrée à l'intégration officielle de l'ablation percutanée guidée par l'image — et tout particulièrement de la **cryoablation percutanée** — dans l'arbre décisionnel du National Comprehensive Cancer Network (NCCN) pour les tumeurs desmoïdes (fibromatoses agressives) : détaille les critères de passage de la surveillance active au traitement ablatif local, les avantages biophysiques de la cryoablation (contrôle visuel de l'iceball, préservation de la matrice collagénique, régression volumétrique prolongée et sédation douloureuse rapide) face aux traitements systémiques et à la chirurgie.}
}

@article{guedes2026_43042097,
  title = {EFFICACY AND SAFETY OF PERCUTANEOUS CRYOABLATION FOR DESMOID TUMORS: PROTOCOL FOR A SYSTEMATIC REVIEW AND META-ANALYSIS},
  author = {Guedes A and de Mattos ESR and Barreto ESR and Romero Antunes C and Vilaboim MDCCF and de Camargo OP},
  journal = {Acta ortopedica brasileira},
  year = {2026},
  volume = {34},
  number = {6},
  pages = {e310502},
  doi = {10.1590/1413-785220263406e310502},
  pmid = {43042097},
  url = {https://pubmed.ncbi.nlm.nih.gov/43042097/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblioosteo/pdfs/PMID_43042097.pdf:application/pdf},
  abstract = {Protocole méthodologique de revue systématique et méta-analyse de niveau de preuve II (*Acta Ortopédica Brasileira*, nov. 2026, IF 0,8, Open-Access PMC13773520) dédié à l'évaluation quantitative de la **cryoablation percutanée chez l'adulte atteint de tumeur desmoïde** à travers les bases CENTRAL, Embase, PubMed et Scopus (évaluation du risque de biais par RoB-2 et ROBINS-I) : définit le **contrôle local (absence de progression locale ou de récidive radiologique/clinique)** comme critère de jugement principal, et structure six critères secondaires standardisés — **soulagement douloureux, taux de complications majeures, taux de retraitement, réduction volumétrique tumorale (mRECIST), amélioration fonctionnelle et survie sans progression (PFS)**.}
}

@article{tolstrup2026_42998777,
  title = {Bleomycin-Induced Pulmonary Toxicity: A Systematic Review and Meta-Analysis of Incidence and Risk Factors},
  author = {Tolstrup M and Lonkvist CK and Gehl J and Lauritsen J},
  journal = {Critical reviews in oncology/hematology},
  year = {2026},
  pages = {105685},
  doi = {10.1016/j.critrevonc.2026.105685},
  pmid = {42998777},
  url = {https://pubmed.ncbi.nlm.nih.gov/42998777/},
  abstract = {Méta-analyse PRISMA 2020 (*Critical Reviews in Oncology/Hematology*, nov. 2026, IF 5,5, équipe de J. Gehl, 65 études / 7 601 patients) évaluant l'incidence et les facteurs de risque de toxicité pulmonaire à la bléomycine IV : contrairement aux cures répétées de chimiothérapie systémique (incidence globale 18 % en oncologie médicale), l'injection unique ou pauciséquentielle d'ECT à faible dose cumulative reste dépourvue de surrisque lié à l'âge ou aux métastases pulmonaires.}
}

@article{kos2026_43041864,
  title = {Longitudinal spatial mapping of tumor-immune microenvironment following electrochemotherapy of cutaneous melanoma metastases},
  author = {Kos T and Milićević S and Gašljević G and Šantek I and Omerzel M and Serša G and Perić B and Čemažar M},
  journal = {Frontiers in immunology},
  year = {2026},
  volume = {17},
  pages = {1984950},
  doi = {10.3389/fimmu.2026.1984950},
  pmid = {43041864},
  url = {https://pubmed.ncbi.nlm.nih.gov/43041864/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblioosteo/pdfs/PMID_43041864.pdf:application/pdf},
  abstract = {Étude translationnelle longitudinale par **transcriptomique spatiale unicellulaire (plateforme Xenium)** sur des biopsies séquentielles de métastases de mélanome traitées par **électrochimiothérapie (ECT)** et de métastases voisines non traitées (à l'état basal, à J2–J3 et à J9–J10 post-ECT) (*Frontiers in Immunology*, nov. 2026, IF 5,7, Open-Access PMC13771791) : au-delà de la cytotoxicité directe par électroporation réversible, l'ECT induit une **réorganisation spatiale active du microenvironnement tumoral (TME)** avec formation d'un **front immunitaire cytotoxique (lymphocytes T infiltrants, cellules myéloïdes activées)** à l'interface tumeur-stroma et déclenche une **immunité anti-tumorale régionale (effet abscopal sur les lésions non traitées)** chez **2 patients sur 3** présentant un microenvironnement basal immunopermissif, tout en faisant basculer les cellules tumorales résiduelles vers un **état dormant exprimant SOX2-OT**.}
}

@article{tang2026_43033832,
