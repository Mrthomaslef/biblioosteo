@article{kadiri2026_42826126,
  title = {Concordance of Microbiological and Histopathological Examination of Bone Biopsies in Diagnosing Diabetic Foot Osteomyelitis, a Systematic Review},
  author = {Kadiri L and Maher A and Bridgen A},
  journal = {Journal of foot and ankle research},
  year = {2026},
  volume = {19},
  number = {4},
  pages = {e70223},
  doi = {10.1002/jfa2.70223},
  pmid = {42826126},
  url = {https://pubmed.ncbi.nlm.nih.gov/42826126/},
  abstract = {Revue systématique selon PRISMA (*Journal of Foot and Ankle Research*, déc. 2026, IF 2,8, Open-Access) portant sur 5 études et **308 patients** ayant bénéficié d'une biopsie osseuse avec double analyse microbiologique et histopathologique simultanée pour suspicion d'ostéomyélite du pied diabétique (DFO) : le taux moyen de **concordance positive entre culture et histologie n'est que de 43,4 %** (concordance négative de 10,8 %, concordance globale de 41 à 92,5 %) ; la **microbiologie offre une sensibilité supérieure (70 à 83,9 %)** indispensable au ciblage antibiotique, tandis que **l'histopathologie apporte une spécificité supérieure** (excluant les contaminations cutanées) et prédit le risque de reprise chirurgicale et d'antibiothérapie prolongée.}
}

@article{grange2026_43052493,
  title = {Computed tomography-guided percutaneous cryoablation for pediatric osteoid osteoma: clinical success and safety},
  author = {Grange S and Grange R and Stacoffe N and Perez K and Al Khoury Salem H and Haddad E and Boucher LM and Pelage JP and Gorelik N},
  journal = {Pediatric radiology},
  year = {2026},
  doi = {10.1007/s00247-026-06841-6},
  pmid = {43052493},
  url = {https://pubmed.ncbi.nlm.nih.gov/43052493/},
  abstract = {Étude rétrospective monocentrique portant sur **18 patients pédiatriques consécutifs** (10 garçons ; âge médian **13,5 ans**, extrêmes 6–17 ans) traités par cryoablation percutanée guidée par scanner pour un ostéome ostéoïde entre décembre 2022 et mai 2025 (*Pediatric Radiology*, nov. 2026, IF 2,1) : le **succès technique et le succès clinique à 1 mois atteignent 100 % (18/18)**, avec un **délai médian de disparition complète des douleurs de 1 jour (IQR 1–2 jours)** — **72 % des enfants (13/18) étant totalement indolores dès 24 heures**, 100 % à 14 jours avec arrêt complet des antalgiques à 1 mois — sans **aucune complication (0 % d'événement indésirable SIR)** et avec une exposition radique faible (**DLP médian de 158 mGy·cm**, IQR 100–300).}
}

